<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Finished Habits</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Overall page background gradient */
        body {
            background: linear-gradient(135deg, #ffad66, #d2691e);
            font-family: Arial, sans-serif;
        }

        /* Container background with gradient */
        .container {
            background: linear-gradient(135deg, #fff3e0, #ffdab9);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            border-radius: 10px;
            padding: 20px;
        }

        /* Button styles with gradient */
        .btn-custom {
            background: linear-gradient(135deg, #d2691e, #ff8c00);
            border: none;
            color: white;
            padding: 10px 20px;
            transition: background 0.3s;
        }

        .btn-custom:hover {
            background: linear-gradient(135deg, #b94e00, #ff7518);
            color: white;
        }

        /* List item styles */
        .list-group-item {
            background: linear-gradient(135deg, #ffe4b2, #ffcc80);
            border: 1px solid #d2691e;
            color: #4b2e2b;
        }
    </style>
</head>
<body>
  <div class="container mt-5 p-4">
    <h1 class="text-center mb-4" style="color: #d2691e;">Finished Habits and Subtasks</h1>

    <% if (finishedHabits.length === 0 && finishedSubtasks.length === 0) { %>
      <p class="text-center">No finished habits or subtasks yet!</p>
    <% } else { %>

      <!-- Finished Habits -->
      <% if (finishedHabits.length > 0) { %>
        <h2>Finished Habits</h2>
        <ul class="list-group">
          <% finishedHabits.forEach(habit => { %>
            <li class="list-group-item">
              <strong><%= habit.name %></strong> - <%= habit.frequency %>
              <!-- Undo button for each finished habit -->
              <form action="/habit/<%= habit._id %>/undo" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-warning">Undo</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <!-- Finished Subtasks -->
      <% if (finishedSubtasks.length > 0) { %>
        <h2 class="mt-4">Finished Subtasks</h2>
        <ul class="list-group">
          <% finishedSubtasks.forEach(subTask => { %>
            <li class="list-group-item">
              <strong>Habit: <%= subTask.habitName %></strong> - Subtask: <%= subTask.name %>
              <!-- Undo button for each finished subtask -->
              <form action="/habit/<%= subTask.habitId %>/subtask/<%= subTask._id %>/undo" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-warning">Undo</button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } %>
    <% } %>

    <!-- Button to go back to Active Habits -->
    <div class="mt-4 text-center">
      <a href="/" class="btn btn-custom">Back to Active Habits</a>
    </div>
  </div>
</body>
</html>